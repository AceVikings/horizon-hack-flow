{
  "name": "@ate/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ATE desktop app (Lane D): Electron shell + React renderer over the daemon API",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fixtures": "ATE_FIXTURES=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screens": "electron-vite build && ATE_FIXTURES=1 ATE_SCREENSHOT_DIR=../../.context/screens electron ."
  },
  "dependencies": {
    "@ate/core": "workspace:*",
