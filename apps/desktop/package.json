{
  "name": "@ate/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ATE desktop app (Lane D): Electron shell + React renderer over the daemon API",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fixtures": "ATE_FIXTURES=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screens": "electron-vite build && ATE_FIXTURES=1 ATE_SCREENSHOT_DIR=../../.context/screens electron .",
    "test": "vitest run",
    "build:web": "vite build -c vite.web.config.ts && mv out/web/web.html out/web/index.html"
  },
  "dependencies": {
    "@ate/approve": "workspace:*",
    "@ate/core": "workspace:*",
    "@ate/ui": "workspace:*",
    "lightweight-charts": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.11",
    "@simplewebauthn/browser": "^13.1.0"
  },
  "build": {
    "appId": "cloud.flowverse.app",
    "productName": "Flow",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
