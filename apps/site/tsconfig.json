{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["vite/client"],
    "noUnusedLocals": true
  },
  "include": ["src", "vite.config.ts"]
}
