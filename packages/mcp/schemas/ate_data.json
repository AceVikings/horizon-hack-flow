{
  "name": "ate_data",
  "description": "Return a small data table for the user (read-only; the app draws it inline). table: swaps = recent HSKSwap pool swaps; book = HashKey Global top-of-book depth (bids and asks); fills = the vault's executed fills with prices; lots = open and closed spread-revert lots; oracle = current Supra, APRO, pool and CEX prices side by side with ages.",
  "inputSchema": {
    "type": "object",
    "required": [
      "table"
    ],
    "properties": {
      "table": {
        "type": "string",
        "enum": [
          "swaps",
          "book",
          "fills",
          "lots",
          "oracle"
        ]
      },
      "market": {
        "type": "string",
        "enum": [
          "hsk-dex:WHSK/USDT:3000",
          "hsk-dex:WBTC/USDT:3000"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Rows (default 20)"
      },
      "network": {
        "type": "string",
        "enum": [
          "vault",
          "mainnet"
        ]
      }
    },
    "additionalProperties": false
  },
  "annotations": {
    "title": "Data table",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
